# 复制为仓库根 .tmp-pg/runtime.env（不入库），或由 up.sh 从 looma-zervi/backend/.env 自动抽取。
# 网关硬编码 legacy → localhost:5200；resume :3003；job :3004；网关 0.0.0.0:3333。
# 多机：见 FLEET.md；客户端只打 :3333。演示职位：POST /v1/jobs/seed-demo（需登录）。

DATABASE_URL=postgres://postgres@127.0.0.1:55433/genzltd_sim
JWT_SECRET=change-me-same-as-looma-or-local-auth
# 开发者工具走 wx.login → Flask/wechat 风格 token 时必填（与签发方同钥）
SUPABASE_JWT_SECRET=
GATEWAY_JWT_SECRET=
ZERVI_DEV_AUTH=1
# resume 侧 consent 闸旁路（小程序 ensureConsent 仍打 compliance stub/Flask）
ZERVI_DEV_BYPASS_CONSENT=1
RESUME_PORT=3003
JOB_PORT=3004
RESUME_SWEEP_INTERVAL_SECS=900
DEPLOY_REGION=CN
# 可选：真 parse；不配则 parse 可能 500，联调可先手工 ingest
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
NO_PROXY=127.0.0.1,localhost,::1
