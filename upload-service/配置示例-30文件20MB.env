# ========================================
# Upload Service Configuration
# 配置方案：30个文件，每个最大20MB
# ========================================

# 服务端口
PORT=3007

# 数据库配置
DATABASE_URL=mysql://root:adirp_password@localhost/adirp_upload
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=40

# Consul配置
CONSUL_URL=http://localhost:8500

# JWT配置
JWT_SECRET=dev-only-secret-change-in-production
JWT_EXPIRATION=86400

# 文件上传配置
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:3007/files

# ========================================
# 批量上传限制配置（您的需求）
# ========================================

# 一次批量上传的最大文件数：30个
MAX_BATCH_SIZE=30

# 单个文件的最大大小：20MB (20 * 1024 * 1024 = 20971520)
MAX_FILE_SIZE=20971520

# 同时处理的最大并发数：15个（建议是批量数的一半）
MAX_CONCURRENT_UPLOADS=15

# ========================================
# AI服务配置
# ========================================

# PyResParser服务地址
PYRESPARSER_URL=http://localhost:5001

# DeepSeek服务地址
DEEPSEEK_URL=http://localhost:11434
DEEPSEEK_MODEL=deepseek-r1:7b

# 功能开关
ENABLE_PARSING=true
ENABLE_PYRESPARSER=true
ENABLE_MINERU=false
ENABLE_DEEPSEEK=true

# ========================================
# 使用方法
# ========================================
# 1. 将此文件复制为 .env
#    cp 配置示例-30文件20MB.env .env
#
# 2. 重新编译服务
#    cargo build --release
#
# 3. 启动服务
#    cargo run --release
#
# 4. 验证配置生效
#    启动时会看到日志：
#    - Max batch size: 30
#    - Max concurrent uploads: 15

